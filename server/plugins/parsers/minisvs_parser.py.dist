#!/usr/bin/env python3
"""
FILE:  minisvs_parser.py

USAGE:  minisvs_parser.py [-h] [-v+] [--timeFormat] [--startDT] [--stopDT] [--no_temp] <dataFile>

DESCRIPTION:  Parse the supplied MiniSVS data and return the json-formatted
              string used by OpenVDM as part of it's Data dashboard.

              The data field contains, by default, a space-separated pair of
              temperature and sound-velocity values (temperature first). Use
              --no_temp when the data field contains a bare sound-velocity
              value only, with no temperature prefix.

  OPTIONS:  [-h] Return the help message.
            [-v+] Increase verbosity (default: warning)
            [--timeFormat] date/time format to use when parsing datafile, default
                           yyyy-mm-ddTHH:MM:SS.sssZ
            [--startTS] optional start crop time (strptime format)
            [--stopTS] optional stop crop time (strptime format)
            [--no_temp] data field contains a bare sound velocity value only
                        (no temperature prefix)
            <dataFile> Full or relative path of the data file to process.

REQUIREMENTS:  Python3.11
               Python Modules:
                   numpy==2.4.0
                   pandas==2.3.0

     BUGS:
    NOTES:
   AUTHOR:  Webb Pinner
  VERSION:  2.15
  CREATED:  2016-08-29
 REVISION:  2026-08-19
"""

import sys
import logging
from os.path import dirname, realpath
import pandas as pd
import numpy as np
import json

sys.path.append(dirname(dirname(dirname(dirname(realpath(__file__))))))

from server.lib.openvdm_plugin import OpenVDMCSVParser

# The data column contains, by default, a "temp sv" (space-separated) pair.
# When no_temp is set, it contains a bare "sv" value only.
FIELDS = ['raw_data']

ROUNDING = {
    'temperature': 2,
    'sound_velocity': 2
}


class MiniSVSParser(OpenVDMCSVParser):
    """Parser for MiniSVS sound velocity sensor data files.

    The raw data column contains, by default, a space-separated
    ``temperature sound_velocity`` pair.  Set ``no_temp=True`` when the data
    field contains a bare sound-velocity value only, with no temperature
    prefix.
    """

    MAX_DELTA_T = pd.Timedelta('10 seconds')

    MIN_SV = 1400.0
    MAX_SV = 1600.0
    MIN_TEMP = -40.0
    MAX_TEMP = 50.0

    def __init__(self, start_dt=None, stop_dt=None, time_format=None,
                 skip_header=False, use_openvdm_api=False, no_temp=False):
        self.no_temp = no_temp
        proc_cols = ['date_time', 'sound_velocity'] if no_temp \
            else ['date_time', 'temperature', 'sound_velocity']
        super().__init__(None, proc_cols, start_dt=start_dt, stop_dt=stop_dt,
                         time_format=time_format, skip_header=skip_header,
                         use_openvdm_api=use_openvdm_api)

    def parse(self, filepath):
        raw_data = {col: [] for col in self.proc_cols}
        errors = []

        # -------------------------
        # Read and parse lines
        # -------------------------
        try:
            for lineno, timestamp_str, remainder, fields in self.read_lines_with_timestamps(filepath):
                logging.debug(f"{timestamp_str}{self.timestamp_separator}{remainder}")

                field_data = dict(zip(FIELDS, fields))

                try:
                    parts = field_data['raw_data'].strip().split()
                    if self.no_temp:
                        sound_velocity = float(parts[0])
                    else:
                        temperature = float(parts[0])
                        sound_velocity = float(parts[1])

                    raw_data['date_time'].append(timestamp_str)
                    if not self.no_temp:
                        raw_data['temperature'].append(temperature)
                    raw_data['sound_velocity'].append(sound_velocity)

                except Exception as err:
                    errors.append(lineno)
                    logging.debug("Line %s skipped due to parse error: %s", lineno, err)

        except Exception as err:
            logging.error("Failed to read file %s: %s", filepath, err)
            return None

        if not raw_data['date_time']:
            logging.warning("No valid MiniSVS data in file: %s", filepath)
            return None

        # -------------------------
        # Build DataFrame
        # -------------------------
        df = pd.DataFrame(raw_data)
        df['date_time'] = pd.to_datetime(df['date_time'], errors='coerce')
        if df['date_time'].isna().all():
            logging.error("All timestamps could not be parsed; aborting.")
            return None
        df = df.dropna(subset=['date_time'])
        df = df.set_index('date_time')

        if self.start_dt or self.stop_dt:
            df = self.crop_data(df)
        if df.empty:
            logging.warning("Dataframe empty after cropping: %s", filepath)
            return None

        # -------------------------
        # DeltaT
        # -------------------------
        df['deltaT'] = df.index.to_series().diff()

        # -------------------------
        # Statistics
        # -------------------------
        logging.info("Tabulating statistics...")
        self.add_row_validity_stat([len(df), len(errors)])
        self.add_time_bounds_stat([df.index.min().to_pydatetime(), df.index.max().to_pydatetime()])
        self.add_bounds_stat([round(df['deltaT'].min().total_seconds(), 3),
                              round(df['deltaT'].max().total_seconds(), 3)], 'DeltaT Bounds', 'seconds')
        self.add_value_validity_stat([len(df[df['deltaT'] <= self.MAX_DELTA_T]),
                                      len(df[df['deltaT'] > self.MAX_DELTA_T])], 'DeltaT Validity')
        self.add_bounds_stat([round(df['sound_velocity'].min(), ROUNDING['sound_velocity']),
                              round(df['sound_velocity'].max(), ROUNDING['sound_velocity'])], 'Sound Speed Bounds', 'm/s')
        self.add_value_validity_stat([len(df[(df['sound_velocity'] >= self.MIN_SV) & (df['sound_velocity'] <= self.MAX_SV)]),
                                      len(df[(df['sound_velocity'] < self.MIN_SV) | (df['sound_velocity'] > self.MAX_SV)])], 'Sound Speed Validity')
        if not self.no_temp:
            self.add_bounds_stat([round(df['temperature'].min(), ROUNDING['temperature']),
                                  round(df['temperature'].max(), ROUNDING['temperature'])], 'Temperature Bounds', 'C')
            self.add_value_validity_stat([len(df[(df['temperature'] >= self.MIN_TEMP) & (df['temperature'] <= self.MAX_TEMP)]),
                                          len(df[(df['temperature'] < self.MIN_TEMP) | (df['temperature'] > self.MAX_TEMP)])], 'Temperature Validity')

        # -------------------------
        # Quality tests
        # -------------------------
        logging.info("Running quality tests...")
        quality_checks = [
            ('Rows', len(df) + len(errors), len(errors)),
            ('DeltaT', len(df), len(df[df['deltaT'] > self.MAX_DELTA_T])),
            ('Sound Speed', len(df), len(df[(df['sound_velocity'] < self.MIN_SV) | (df['sound_velocity'] > self.MAX_SV)]))
        ]
        if not self.no_temp:
            quality_checks.append(('Temperature', len(df),
                                   len(df[(df['temperature'] < self.MIN_TEMP) | (df['temperature'] > self.MAX_TEMP)])))

        for col, total, bad in quality_checks:
            error_rate = bad / total
            if error_rate > 0.25:
                self.add_quality_test_failed(col)
            elif error_rate > 0.10:
                self.add_quality_test_warning(col)
            else:
                self.add_quality_test_passed(col)

        # -------------------------
        # Resample and round
        # -------------------------
        df = self.resample_data(df)
        df = self.round_data(df, ROUNDING)
        df = df.set_index('date_time')

        # -------------------------
        # Visualization
        # -------------------------
        logging.info("Building visualization datasets...")

        viz_cols = [('sound_velocity', 'm/s', 'Sound Speed')]
        if not self.no_temp:
            viz_cols.append(('temperature', 'C', 'Temperature'))

        for col, unit, label in viz_cols:
            visualizer_data_obj = {'data': [], 'unit': unit, 'label': label}
            for ts, row in df.iterrows():
                if pd.notna(row[col]):
                    ts = pd.Timestamp(ts)
                    if ts.tzinfo is None:
                        ts = ts.tz_localize('UTC')
                    epoch_ms = int(ts.timestamp() * 1000)
                    visualizer_data_obj['data'].append([epoch_ms, row[col]])

            self.add_visualization_data(visualizer_data_obj)

        # -------------------------
        # Send errors to OpenVDM
        # -------------------------
        self.send_error_msg(errors, filepath)

    @classmethod
    def add_cli_arguments(cls, parser):
        """Add the --no_temp CLI option."""
        parser.add_argument('--no_temp', action='store_true', default=False,
                            help='Data field contains a bare sound velocity value only '
                                 '(no temperature prefix)')

    @classmethod
    def _extract_custom_cli_kwargs(cls, args):
        """Translate the --no_temp CLI option into a constructor kwarg."""
        return {'no_temp': getattr(args, 'no_temp', False)}

# -------------------------------------------------------------------------------------
# Standalone CLI
# -------------------------------------------------------------------------------------
if __name__ == "__main__":
    MiniSVSParser.run_cli()
